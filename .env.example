# WAHA. Inside Compose the worker reaches it at http://waha:3000.
WAHA_URL=http://waha:3000
# Sent as X-Api-Key when set. Leave empty only with WAHA_NO_API_KEY=true.
WAHA_API_KEY=
WAHA_NO_API_KEY=true
WAHA_SESSION=default
# Group id from `npm run groups`, for example 120363012345678901@g.us
WAHA_GROUP_ID=
INTERVAL_MINUTES=5

# Optional WAHA engine. WEBJS is the default for devlikeapro/waha:latest.
# WHATSAPP_DEFAULT_ENGINE=WEBJS

# Transcription. speaches is the local Whisper service in docker-compose. openai is optional.
TRANSCRIBE_PROVIDER=speaches
WHISPER_BASE_URL=http://whisper:8000/v1
# Multilingual base model (~150 MB). Change this and Speaches preloads the same id.
WHISPER_MODEL=Systran/faster-whisper-base
# Only if you set API_KEY on the whisper container. Leave empty otherwise.
WHISPER_API_KEY=
# Used only when TRANSCRIBE_PROVIDER=openai.
OPENAI_API_KEY=

# Images, PDFs and other files are inlined as base64. Larger files omit the bytes and set note=too_large.
MAX_INLINE_FILE_MB=5

GROKBOT_WEBHOOK_URL=https://example.com/webhook
GROKBOT_WEBHOOK_KEY=
# Empty uses Authorization: Bearer ${GROKBOT_WEBHOOK_KEY}.
GROKBOT_WEBHOOK_HEADER=Authorization: Bearer ${GROKBOT_WEBHOOK_KEY}

# alias=owner/repo pairs. The first alias found in message text sets payload.repo.
REPO_ALIASES=#plataforma=jreyessn/plataforma_tm

# Cursor directory. Compose mounts a volume here.
DATA_DIR=/data
