# WAHA (WhatsApp HTTP API). Inside docker-compose the worker reaches WAHA at http://waha:3000.
WAHA_URL=http://waha:3000
# Sent as the X-Api-Key header when set. Leave empty only when WAHA_NO_API_KEY=true.
WAHA_API_KEY=
# true skips WAHA's generated key. Set to false in production and set WAHA_API_KEY on both services.
WAHA_NO_API_KEY=true
# Session name created by `npm run login`. WAHA's default session name is "default".
WAHA_SESSION=default
# Group JID from `npm run groups`, for example 120363012345678901@g.us
WAHA_GROUP_ID=
# How often the worker polls for new messages.
INTERVAL_MINUTES=5

# Optional engine override for the waha service (WEBJS is the default for devlikeapro/waha:latest).
# WHATSAPP_DEFAULT_ENGINE=WEBJS

# OpenAI Whisper. Required only when the group sends audio or video.
OPENAI_API_KEY=

# Grokbot webhook. Nothing is posted when a cycle finds no new messages.
GROKBOT_WEBHOOK_URL=https://example.com/webhook
GROKBOT_WEBHOOK_KEY=
# Header name and value. ${GROKBOT_WEBHOOK_KEY} is replaced with the key above.
# A value with no colon is treated as the header name and the raw key is the value.
GROKBOT_WEBHOOK_HEADER=Authorization: Bearer ${GROKBOT_WEBHOOK_KEY}

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Required for images, PDFs, and other files.
# Audio and video are transcribed and are not uploaded.
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=wa-ingest
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket.
STORAGE_PREFIX=wa-ingest/
# Presigned GET URL lifetime in seconds. 604800 is 7 days (R2 maximum).
STORAGE_URL_EXPIRES_SECONDS=604800

# Comma-separated alias=owner/repo pairs. The first alias found in message text sets payload.repo.
# Matching is a literal substring of the text field (captions and extracted PDF text included).
REPO_ALIASES=#plataforma=jreyessn/plataforma_tm

# Cursor file directory. docker-compose mounts a volume here.
DATA_DIR=/data
